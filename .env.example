# ── Aether environment configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every value below has a safe development default in
# packages/server/src/config.ts except DATABASE_URL (required).

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Required. For local development: postgresql://user:pass@localhost:5432/aether
# (the embedded dev database script writes this for you).
DATABASE_URL=postgresql://aether:aether@127.0.0.1:5432/aether
# Browser origin(s) allowed by CORS, comma-separated. With the single-origin
# web proxy (packages/web/server.mjs) the browser only talks to :3000, so this
# mostly matters for split-origin deployments.
CORS_ORIGINS=http://localhost:3000
# Public URL of the web frontend — used in emails and OAuth redirects.
WEB_URL=http://localhost:3000
# ≥32 random characters. Use `openssl rand -base64 48` in production.
SESSION_SECRET=dev-only-session-secret-change-me-000000
SESSION_TTL_HOURS=336
# Set to true only behind HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false

# ── Database / cache ──────────────────────────────────────────────────────────
# Optional. Without Redis, presence is process-local (single node only).
REDIS_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
# smtp | console | none. "console" logs email bodies to the API log
# (development). "none" disables sending (links still work from logs/DB).
EMAIL_PROVIDER=console
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=Aether <no-reply@aether.local>

# ── File storage ──────────────────────────────────────────────────────────────
# local | cloudinary | s3 (s3 also covers Cloudflare R2)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Voice & video (LiveKit) ───────────────────────────────────────────────────
# All three must be set for voice/video/screen-share; otherwise the API
# reports /api/voice/status → configured:false and the UI shows an explicit
# "voice is not configured" state (never faked).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_MAX_PARTICIPANTS=25

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# POST /api/auth/google exchanges a Google ID token for an Aether session.
GOOGLE_CLIENT_ID=

# ── Rate limiting (requests per minute) ──────────────────────────────────────
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=300

# ── Logging ───────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Web (packages/web) ────────────────────────────────────────────────────────
# Used by packages/web/server.mjs to proxy /api and /socket.io to the API.
API_ORIGIN=http://127.0.0.1:4000
# Split-origin deployments only (see DEPLOYMENT.md): absolute API base URL.
NEXT_PUBLIC_API_URL=
