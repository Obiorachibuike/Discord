# Copy to .env for local development. NEVER commit .env. Dev URLs are examples, not credentials.
NODE_ENV=development
# This URL's password is for the bundled local-only embedded Postgres, NOT Docker Compose or production.
# Docker Compose requires a unique POSTGRES_PASSWORD in .env and matching DATABASE_URL (and TEST_DATABASE_URL if testing).
# Example command: printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cove?schema=public
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# Number of trusted proxy hops. Local: 0. Production: 1 for the web proxy, or 2 if the web tier also sits behind a trusted TLS proxy. Restrict API ingress.
TRUST_PROXY=0
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Required in production: at least 32 random characters, e.g. openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-character-string-before-deploying
# Leave unset for a single API instance; required for distributed sockets/presence/rate limiting
# REDIS_URL=redis://localhost:6379
# EMAIL_FROM="Cove <noreply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# In development only: registration auto-verifies if SMTP is not configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# STORAGE_PROVIDER=local   # local | cloudinary | s3
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cove_test
# LOG_LEVEL=info
MAX_UPLOAD_MB=10
